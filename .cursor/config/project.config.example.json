{
  "project_name": "myapp",
  "project_root": "/home/deploy/myapp",
  "site_url": "https://myapp.example.com",

  "services": {
    "backend": {
      "name": "myapp",
      "port": 5003,
      "build_cmd": "npm run build",
      "restart_cmd": "sudo systemctl restart myapp",
      "status_cmd": "systemctl status myapp --no-pager",
      "health_endpoint": "/api/health"
    },
    "frontend": {
      "name": "myapp-web",
      "port": 3001,
      "subdir": "apps/web",
      "build_cmd": "npm run build",
      "restart_cmd": "sudo systemctl restart myapp-web",
      "status_cmd": "systemctl status myapp-web --no-pager"
    }
  },

  "auth": {
    "secrets_dir": ".cursor/.secrets",
    "basic_auth_file": "site-basic-auth.json",
    "test_user_file": "api-test-user.json",
    "test_user_email": "agent-test@example.com"
  },

  "verify_pages": [
    "/",
    "/api/health",
    "/dashboard",
    "/login"
  ],

  "scan_dirs": {
    "backend": "src",
    "frontend": "apps/web"
  },

  "data_dir": ".cursor/data"
}
